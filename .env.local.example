NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional - error tracking (docs/PRODUCTION_READINESS_CHECKLIST.md §11). The app builds
# and runs fine with these unset; Sentry is simply inactive until NEXT_PUBLIC_SENTRY_DSN is
# provided. Get a DSN by creating a free project at https://sentry.io yourself - Claude
# Code can't create third-party accounts on your behalf.
NEXT_PUBLIC_SENTRY_DSN=
# The three below are only needed to upload source maps on build (readable stack traces in
# Sentry) - leave unset and the build still succeeds, just without source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
