NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional - error tracking. The app builds
# and runs fine with these unset; Sentry is simply inactive until NEXT_PUBLIC_SENTRY_DSN is
# provided. The DSN is public by design (it ships in the browser bundle); the auth token below is
# the secret. Set these on your host for Production (and Preview if you want preview errors
# reported), not in local .env.local unless you want development noise in Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# The three below are only needed to upload source maps on build (readable stack traces in
# Sentry) - leave unset and the build still succeeds, just without source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
